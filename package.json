{
  "name": "vue3-router-middlewares",
  "version": "0.1.1",
  "description": "Apply middleware functions to Vue Router navigation through route meta fields.",
  "keywords": [
    "middleware",
    "middlewares",
    "navigation-guard",
    "plugin",
    "typescript",
    "vue",
    "vue-router",
    "vue3"
  ],
  "homepage": "https://github.com/quentinjuarez/vue3-router-middlewares#readme",
  "bugs": "https://github.com/quentinjuarez/vue3-router-middlewares/issues",
  "license": "MIT",
  "author": "quentinjuarez (https://www.quentinjuarez.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinjuarez/vue3-router-middlewares.git"
  },
  "files": [
    "dist",
    "src/types.d.ts"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt . '!**/global.d.ts'",
    "format:check": "oxfmt --check . '!**/global.d.ts'",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn build",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/compiler-dom": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "packageManager": "yarn@3.8.6"
}
